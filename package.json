{
  "name": "tauri-plugin-visual-editor",
  "version": "0.1.2",
  "private": true,
  "description": "Visual Inspector plugin for Tauri 2 \u2014 Context Bundles for AI editors",
  "workspaces": [
    "examples/*",
    "packages/*",
    "packages/messages"
  ],
  "scripts": {
    "checks": "scripts/run-checks.sh",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:guest": "npm run build --workspace=@tauri-plugin/visual-editor",
    "build:sdk": "npm run build --workspace=@iamthamanic/visual-editor-sdk",
    "build:inspector": "npm run build --workspace=@tauri-plugin/visual-editor-inspector-app && rm -rf crates/plugin/inspector-dist && cp -R packages/inspector-app/dist crates/plugin/inspector-dist",
    "build:launcher": "npm run build --workspace=@hardlyui/launcher",
    "launcher": "npm run tauri --workspace=@hardlyui/launcher -- dev",
    "bench:idle": "tsx bench/idle-overhead.ts",
    "vendor:messages": "node packages/messages/scripts/vendor.mjs",
    "check:messages": "node packages/messages/scripts/vendor.mjs --check",
    "test:ui": "npm run build:inspector && node tests/ui/run.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1",
    "tsx": "^4.20.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamthamanic/tauri-plugin-visual-editor.git"
  }
}
